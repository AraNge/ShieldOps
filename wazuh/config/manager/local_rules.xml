<group name="docker,">
  <rule id="100015" level="3">
    <if_sid>86001, 86000</if_sid>
    <match>image pulled</match>
    <description>Docker: Image pulled: $(remote)</description>
  </rule>
</group>


<group name="syslog,sudo,docker,">
  <rule id="100017" level="6">
    <if_sid>5402, 5403</if_sid>
    <match>COMMAND=/usr/bin/docker</match>
    <description>Docker: $(command)</description>
    <group>docker,audit,</group>
  </rule>
</group>


<group name="docker,">
  
  <!-- Parent rule for all Docker container events -->
  <rule id="100001" level="5">
    <decoded_as>json</decoded_as>
    <field name="type">container</field>
    <description>Docker: Container event detected</description>
  </rule>

  <!-- Stop/destroy events (level 7 - higher severity) -->
  <rule id="100002" level="7" overwrite="yes">
    <if_sid>100001</if_sid>
    <field name="docker.Action">^die$|^kill$|^stop$|^destroy$</field>
    <description>Docker: Container $(docker.Actor.Attributes.name) stopped or destroyed</description>
  </rule>

  <!-- Start/create events (level 3 - informational) -->
  <rule id="100003" level="3" overwrite="yes">
    <if_sid>100001</if_sid>
    <field name="docker.Action">^start$|^restart$|^create$</field>
    <description>Docker: Container $(docker.Actor.Attributes.name) started or created</description>
  </rule>

  <!-- Pause events -->
  <rule id="100008" level="4" overwrite="yes">
    <if_sid>100001</if_sid>
    <field name="docker.Action">^pause$</field>
    <description>Docker: Container $(docker.Actor.Attributes.name) paused</description>
  </rule>

  <!-- Unpause events -->
  <rule id="100009" level="4" overwrite="yes">
    <if_sid>100001</if_sid>
    <field name="docker.Action">^unpause$</field>
    <description>Docker: Container $(docker.Actor.Attributes.name) unpaused</description>
  </rule>

  <!-- Priviliged container detection -->
  <rule id="100006" level="12">
    <field name="docker.Actor.Attributes.privileged">true</field>
    <description>Docker: Privileged container detected</description>
  </rule>

  <!-- Suspicious volume mounts -->
  <rule id="100007" level="10">
    <field name="docker.Actor.Attributes.volume">/:/host|docker.sock</field>
    <description>Docker: Suspicious volume mount detected</description>
  </rule>

</group>